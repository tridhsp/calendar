// Build Supabase client from your Netlify function (same pattern as main page)
let client;
async function initSupabase() {
    const res = await fetch('/api/cal-supabase-credentials');
    if (!res.ok) throw new Error('Failed to load credentials');
    const { SUPABASE_URL, ANON_PUBLIC_KEY } = await res.json();
    client = window.supabase.createClient(SUPABASE_URL, ANON_PUBLIC_KEY, {
        auth: { persistSession: true, autoRefreshToken: true, storage: window.localStorage, detectSessionInUrl: true }
    });

    // Wait for Supabase to finish loading session from localStorage
    // Without this, getSession() can return null on cold page load
    await new Promise((resolve) => {
        const { data: { subscription } } = client.auth.onAuthStateChange((event) => {
            if (event === 'INITIAL_SESSION') {
                subscription.unsubscribe();
                resolve();
            }
        });
        // Safety timeout: don't wait forever (3 seconds max)
        setTimeout(() => { try { subscription.unsubscribe(); } catch { } resolve(); }, 3000);
    });
}

// Ensure our Supabase session is present & fresh before making writes
async function ensureAuthFresh() {
    if (!client) throw new Error('Supabase not ready');

    // 1) Try current session
    let { data: { session } } = await client.auth.getSession();

    // 2) If missing, try to silently refresh using stored refresh_token
if (!session) {
        const { data, error } = await client.auth.refreshSession();
        if (error || !data?.session) {
            throw new Error('Not authenticated. Please log in again.');
        }
        session = data.session;
    }

    // 3) If session is about to expire (<60s), refresh it
    const expMs = session.expires_at ? session.expires_at * 1000 : 0;
    if (expMs && expMs - Date.now() < 60_000) {
        const { error } = await client.auth.refreshSession();
        if (error) {
            throw error;
        }
    }

    return session;
}


// === Always get a fresh token before protected calls + simple retry ===
async function getFreshToken() {
    const session = await ensureAuthFresh();       // refresh if needed
    const token = session?.access_token || '';
    try { client?.realtime?.setAuth?.(token || null); } catch { }
    return token;
}

async function fetchWithAuth(url, options = {}) {
    const doFetch = async (tok) => {
        const headers = new Headers(options.headers || {});
        headers.set('Authorization', `Bearer ${tok}`);

        // If you’re sending JSON but forgot the header, set it for you.
        const hasBody = typeof options.body !== 'undefined' && options.body !== null;
        if (hasBody && !headers.has('Content-Type')) {
            headers.set('Content-Type', 'application/json');
        }

        return fetch(url, { ...options, headers });
    };

    let token = await getFreshToken();
    let res = await doFetch(token);

    // If the tab was idle and token just expired, refresh once and retry
    if (res.status === 401 || res.status === 403) {
        token = await getFreshToken();
        res = await doFetch(token);
    }
    return res;
}





