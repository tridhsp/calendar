/* === Add Student dialog helper === */
function showAddStudentDialog(initialValue = '') {
    return new Promise(resolve => {
        const overlay = document.getElementById('addStudentBox');
        const input = document.getElementById('addStudentInput');
        const okBtn = document.getElementById('addStudentOk');
        const closeBtn = document.getElementById('addStudentClose');

        let keyHandler;

        function close(ok) {
            const value = (input.value || '').trim();
            overlay.hidden = true;
            okBtn.removeEventListener('click', onOk);
            closeBtn.removeEventListener('click', onClose);
            overlay.removeEventListener('click', onBackdrop);
            document.removeEventListener('keydown', keyHandler);
            resolve({ ok, value });
        }
        function onOk() { close(true); }
        function onClose() { close(false); }
        function onBackdrop(e) { if (e.target === overlay) close(false); }

        keyHandler = (e) => {
            if (e.key === 'Escape') close(false);
            if (e.key === 'Enter') onOk();
        };

        input.value = initialValue || '';

        // NEW: reset suggestion list + any selected email each time the popup opens
        const suggest = document.getElementById('addStudentSuggest');
        if (suggest) { suggest.hidden = true; suggest.innerHTML = ''; }
        input.dataset.email = '';

        overlay.hidden = false;
        input.focus();
        input.select();

        okBtn.addEventListener('click', onOk);
        closeBtn.addEventListener('click', onClose);
        overlay.addEventListener('click', onBackdrop);
        document.addEventListener('keydown', keyHandler);
    });
}





async function addStudentAndJoin({ email, name }) {
    // If card already exists, just bring it into view
    const exists = document.getElementById(`card_${email}`);
    if (exists) {
        exists.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
    }

    // NEW: Luyen thi - Mock Test popup (immediately after toggling Join)
    try { if (window.showLuyenThiMockTest) await window.showLuyenThiMockTest(email); } catch (_) {}
    // Ask for meeting proof (same step as flipping the Join toggle)
    const { ok, imageUrl } = await showConfirm(name);
    if (!ok) return;

    // Identify teacher email (same as join toggle code)
    const { data: { user } } = await client.auth.getUser();
    let teacherEmail = user?.email || '';
    if (user?.id) {
        const { data: ur } = await client.from('user_roles').select('email').eq('uid', user.id).maybeSingle();
        teacherEmail = ur?.email || teacherEmail;
    }

    // Create/append the learn_status_reports row via your Netlify function
    const payload = {
        student_email: email,
        student_name: name,
        check_in_teacher: teacherEmail || '',
        hinh_chup_meeting: imageUrl || ''
    };

    const res = await fetchWithAuth('/api/learn-status-report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    });



    if (!res.ok) throw new Error(await res.text());
    const payloadRes = await res.json();
    const startIso = payloadRes?.data?.start_time;

    // Ensure state maps exist
    if (!window._ltState) window._ltState = {};
    if (!window._ltState.hvByEmail) window._ltState.hvByEmail = new Map();
    if (!window._ltState.byStudent) window._ltState.byStudent = new Map();

    // Ensure we know profile (status/max/name)
    let hv = window._ltState.hvByEmail.get(email);
    if (!hv) {
        const { data: hvRow } = await client
            .from('danh_sach_hv')
            .select('email,status,ten_hv,max')
            .eq('email', email)
            .maybeSingle();
        hv = hvRow || { email, ten_hv: name, status: '', max: 25 };
        window._ltState.hvByEmail.set(email, hv);
    }

    // Put this ad-hoc student into byStudent with no schedule slots
    if (!window._ltState.byStudent.has(email)) {
        window._ltState.byStudent.set(email, []); // empty slots = ad-hoc
    }

    // Insert card into the active grid
    const grid = document.getElementById('activeGrid') ||
        (() => {
            const g = document.createElement('div');
            g.className = 'student-grid';
            g.id = 'activeGrid';
            document.getElementById('learnTodayContent').appendChild(g);
            return g;
        })();

    grid.insertAdjacentHTML('afterbegin', buildAdhocCardHTML({
        email,
        name: hv.ten_hv || name || email,
        status: hv.status || ''
    }));

    // Start UI like a joined card

    // mark joined so sort & badges stay consistent
    window._ltState?.joinedTodaySet?.add(email);

    const { early_start, late_start } = payloadRes?.data || {};
    if (early_start) {
        showStartDelta(email, 'Early', early_start);
    } else if (late_start) {
        showStartDelta(email, 'Late', late_start);
    } else {
        showStartDelta(email, 'On time', '00:00:00');
    }

    const tuWrap = document.getElementById(`tu_wrap_${email}`);
    const tuEl = document.getElementById(`tu_${email}`);
    if (tuWrap) tuWrap.hidden = false;
    if (tuEl && startIso) startStopwatchFor(tuEl, startIso, email);

    const tlWrap = document.getElementById(`tl_wrap_${email}`);
    const tlEl = document.getElementById(`tl_${email}`);
    const limitMins = computeLimitMins(
        email,
        window._ltState.byStudent,
        window._ltState.hvByEmail,
        window._ltState?.perStudent || {}
    );


    if (tlWrap && tlEl && limitMins > 0 && startIso) {
        tlWrap.hidden = false;
        startTimeLeftFor(tlEl, startIso, limitMins, email);
    }

    const cb = document.getElementById(`comp_${email}`);
    if (cb) { cb.hidden = false; cb.disabled = false; }

    // Cross-tab: tell other tabs this student just joined
    if (window.ltSend) ltSend({ type: 'joined', email });

    if (window.requestGridReorder) window.requestGridReorder();


}

