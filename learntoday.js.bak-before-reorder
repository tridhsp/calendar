// Accept "HH:MM", "HH:MM:SS", "8:00", "8:00 am", etc → return "HH:MM" 24h
function normalizeHHMM(raw) {
    if (!raw) return null;
    let s = String(raw).trim().toLowerCase().replace(/\./g, ':');

    // allow optional seconds + optional am/pm
    const m = s.match(/^(\d{1,2})(?::(\d{1,2}))?(?::(\d{1,2}))?\s*(am|pm)?$/);
    if (!m) return null;

    let h = parseInt(m[1], 10);
    let min = parseInt(m[2] ?? '0', 10);
    const ap = m[4];

    if (ap === 'pm' && h < 12) h += 12;
    if (ap === 'am' && h === 12) h = 0;

    if (h < 0 || h > 23 || min < 0 || min > 59) return null;
    return `${String(h).padStart(2, '0')}:${String(min).padStart(2, '0')}`;
}

function diffNote(initial, next) {
    const a = String(initial || '').trim();
    const b = String(next || '').trim();
    return b && b !== a ? b : '';
}


function hhmmToMinutes(hhmm) {
    const [h, m] = hhmm.split(':').map(Number);
    return h * 60 + m;
}


// Get earliest "HH:MM" time_local for a student (string compare works for HH:MM)
// Get earliest "HH:MM" (24h) from that student's slots (handles AM/PM etc.)
function getEarliestTimeLocalFor(email, byStudent) {
    const slots = byStudent.get(email) || [];
    let bestStr = null;
    let bestMin = Infinity;
    for (const s of slots) {
        const norm = normalizeHHMM(s.time_local);
        if (!norm) continue;
        const mins = hhmmToMinutes(norm);
        if (mins < bestMin) { bestMin = mins; bestStr = norm; }
    }
    return bestStr; // e.g. "08:00" or null
}


// Return milliseconds (positive = LATE, negative = EARLY)
function diffFromScheduledMs(startIso, timeLocalRaw) {
    const norm = normalizeHHMM(timeLocalRaw);        // "HH:MM"
    if (!startIso || !norm) return 0;

    // Use robust parser that normalizes space→T and falls back gracefully
    const actual = toSafeMs(startIso);

    // Compare against Bangkok local schedule time for today
    const ymd = getBangkokYMD();                     // "YYYY-MM-DD"
    const sched = new Date(`${ymd}T${norm}:00+07:00`).getTime();

    return actual - sched; // >0 late, <0 early
}


// Ask server to compute Early/Late/On time (timezone-safe)
async function serverComputeStartDelta(startIso, schedTimes = []) {
    const r = await fetchWithAuth('/api/compute-start-delta', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            start_time_iso: startIso,
            schedule_times: schedTimes,
            tz: 'Asia/Bangkok'
        })
    });

    if (!r.ok) throw new Error(await r.text().catch(() => 'compute-start-delta failed'));
    const out = await r.json();
    return out?.data || null; // { label, hhmmss, early_start, late_start }
}


function showStartDelta(email, label, hhmmss) {
