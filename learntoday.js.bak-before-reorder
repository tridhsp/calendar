/* === Time Used (stopwatch) — single RAF loop (rock-solid) === */
const STOPWATCHES = new Map(); // email -> { el, startMs }
let SW_LOOP = null;

// Turn hardening on/off without touching the rest of the code
const ENABLE_RT_HARDEN = true;


function formatHMS(totalMs) {
    const s = Math.max(0, Math.floor(totalMs / 1000));
    const hh = String(Math.floor(s / 3600)).padStart(2, '0');
    const mm = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
    const ss = String(s % 60).padStart(2, '0');
    return `${hh}:${mm}:${ss}`;
}

function toSafeMs(dt) {
    if (dt == null) return Date.now();
    if (typeof dt === 'number' && Number.isFinite(dt)) return dt;        // epoch ms
    if (dt instanceof Date && !isNaN(dt)) return dt.getTime();           // Date
    const s = String(dt);
    const fixed = s.includes('T') ? s : s.replace(' ', 'T');
    const ms = Date.parse(fixed);
    return Number.isFinite(ms) ? ms : Date.now();
}


function ensureStopwatchLoop() {
    if (SW_LOOP) return;
    const step = () => {
        // Early exit if nothing to do
        if (STOPWATCHES.size === 0) { SW_LOOP = null; return; }

        const now = Date.now();

        // throttle: only do work once per second (rAF still pauses in bg tabs)
        const nowSec = Math.floor(now / 1000);
        if (step._lastSec === undefined) step._lastSec = nowSec;
        if (nowSec === step._lastSec) {
            SW_LOOP = requestAnimationFrame(step);
            return;
        }
        step._lastSec = nowSec;

        for (const [k, rec] of STOPWATCHES) {
            if (!rec?.el || !rec.el.isConnected) { // auto-prune if DOM node is gone
                STOPWATCHES.delete(k);
                continue;
            }
            const next = formatHMS(now - rec.startMs);
            if (rec.el.textContent !== next) {
                rec.el.textContent = next;
            }
        }

        SW_LOOP = requestAnimationFrame(step);
    };

    SW_LOOP = requestAnimationFrame(step);
}



function startStopwatchFor(el, startIso, key) {
    STOPWATCHES.set(key, { el, startMs: toSafeMs(startIso) });
    // paint once immediately
    el.textContent = formatHMS(Date.now() - STOPWATCHES.get(key).startMs);
    ensureStopwatchLoop();
}

function stopAllStopwatches() {
    STOPWATCHES.clear();
    if (SW_LOOP) { cancelAnimationFrame(SW_LOOP); SW_LOOP = null; }
}

// Stop stopwatch for ONE student (by email key)
function stopStopwatchFor(key) {
    STOPWATCHES.delete(key);
    if (STOPWATCHES.size === 0 && SW_LOOP) { cancelAnimationFrame(SW_LOOP); SW_LOOP = null; }
}

// Pause all "Time left" countdowns
function stopAllTimeLefts() {
    for (const key of Array.from(TIMELEFTS.keys())) stopTimeLeft(key);
    if (typeof TL_LOOP !== 'undefined' && TL_LOOP) {
        clearInterval(TL_LOOP);
        TL_LOOP = null;
    }
}



// Pause "Time left" countdown for ONE student (keep current label/styles)
function pauseTimeLeftFor(key) {
    TIMELEFTS.delete(key);
    if (typeof TL_LOOP !== 'undefined' && TL_LOOP && TIMELEFTS.size === 0) {
        clearInterval(TL_LOOP);
        TL_LOOP = null;
    }
}



/* === Time Left (countdown with overtime “Exceeded”) === */
const TIMELEFTS = new Map(); // email -> { el, wrap, labelEl, card, endMs }

// --- Realtime overlay of the freshest LSR rows in THIS TAB (beats replica lag) ---
const PENDING_LSR = new Map(); // email -> most-recent LSR row we saw
function rememberPendingLsr(row) {
    try {
        const em = row?.student_email;
        if (!em) return;

        // Only keep rows that are for TODAY (Bangkok)
        const st = row?.start_time;
        const ct = row?.completed_at;
        const isToday = (st && isBangkokSameDay(st)) || (ct && isBangkokSameDay(ct));
        if (!isToday) { PENDING_LSR.delete(em); return; }

        const prev = PENDING_LSR.get(em);
        const stamp = Date.parse(ct || st || 0) || 0;
        const prevStamp = prev ? (Date.parse(prev.completed_at || prev.start_time || 0) || 0) : -1;

        if (stamp >= prevStamp) PENDING_LSR.set(em, row);
    } catch (_) { /* no-op */ }
}


// Coalesce many reorder calls into one per animation frame (keeps UI smooth)
window.requestGridReorder = (() => {
    let pending = false;
    return () => {
        if (pending) return;
        pending = true;
        requestAnimationFrame(() => {
            pending = false;
            try { window.reorderActiveGrid?.(); } catch { }
        });
    };
})();


/* === Time Left (countdown with overtime “Exceeded”) — single shared loop === */
let TL_LOOP = null;

function ensureTimeLeftLoop() {
    if (TL_LOOP) return;
    const THRESH_MS = 10 * 60 * 1000; // 10 minutes

    TL_LOOP = setInterval(() => {
        // Stop the interval immediately if there's nothing to do
        if (TIMELEFTS.size === 0) {
            clearInterval(TL_LOOP);
            TL_LOOP = null;
            return;
        }

        if (document.hidden) return; // skip work while tab isn’t visible

        const now = Date.now();

        for (const [key, r] of TIMELEFTS) {
            const { el, wrap, labelEl, card, endMs } = r;
            if (!el || !el.isConnected) { TIMELEFTS.delete(key); continue; }

            let mode = 'normal';

            if (now < endMs) {
                const remaining = endMs - now;
                const nextRemain = formatHMS(remaining);
                setTextIfDiff(el, nextRemain);
                if (labelEl) setTextIfDiff(labelEl, 'Time left');

                if (wrap) {
                    wrap.classList.remove('exceeded');
                    if (remaining <= THRESH_MS) {
                        wrap.classList.add('alert'); mode = 'alert';
                    } else {
                        wrap.classList.remove('alert');
                    }
                }
            } else {
                const overtime = now - endMs;
                const nextOver = formatHMS(overtime);
                setTextIfDiff(el, nextOver);
                if (labelEl) setTextIfDiff(labelEl, 'Exceeded');
                if (wrap) { wrap.classList.add('alert', 'exceeded'); mode = 'exceeded'; }
                if (card) card.classList.add('exceeded-alert');
            }

            if (wrap) {
                const prev = wrap.dataset.mode || '';
                if (prev !== mode) {
                    wrap.dataset.mode = mode;
                    if (window.requestGridReorder) window.requestGridReorder();
                }
            }
        }
    }, 1000);
}


function startTimeLeftFor(el, startIso, totalMinutes, key) {
    const wrap = el.closest('.time-left');
    const labelEl = wrap ? wrap.querySelector('.tl-label') : null;
    const card = wrap ? wrap.closest('.student-card') : null;

    const totalMs = Math.max(0, (parseInt(totalMinutes, 10) || 0) * 60000);
    if (!totalMs) { el.textContent = '--:--:--'; return; }

    const start = toSafeMs(startIso);
    const endMs = start + totalMs;

    // paint once immediately
    const now = Date.now();
    if (now < endMs) {
        el.textContent = formatHMS(endMs - now);
        if (labelEl) labelEl.textContent = 'Time left';

        if (wrap) { wrap.classList.remove('alert', 'exceeded'); }

    } else {
        el.textContent = formatHMS(now - endMs);
        if (labelEl) labelEl.textContent = 'Exceeded';
        if (wrap) wrap.classList.add('alert', 'exceeded');
        if (card) card.classList.add('exceeded-alert');
    }

    TIMELEFTS.set(key, { el, wrap, labelEl, card, endMs });
    ensureTimeLeftLoop();
}

function stopTimeLeft(key) {
    TIMELEFTS.delete(key);

    const wrap = document.getElementById(`tl_wrap_${key}`);
    if (wrap) {
        wrap.classList.remove('alert', 'exceeded');
        wrap.removeAttribute('data-mode');
        const lbl = wrap.querySelector('.tl-label');
        if (lbl) lbl.textContent = 'Time left';
    }

    const card = wrap ? wrap.closest('.student-card') : null;
    if (card) card.classList.remove('exceeded-alert');
}


// Show/hide the "Completed today" title
function refreshCompletedVisibility() {
    const grid = document.getElementById('completedGrid');
    const title = document.getElementById('completedTitle');
    if (grid && title) title.style.display = grid.children.length ? 'block' : 'none';
}

// Move one student's card to the Completed section
function moveCardToCompleted(email, completedAtIso) {
    const card = document.getElementById(`card_${email}`);
    const completedGrid = document.getElementById('completedGrid');
    if (!card || !completedGrid) return;

    // Save timestamp (ms since epoch). If invalid/missing, treat as 0 (oldest).
    const ts = Date.parse(completedAtIso || '') || 0;
    card.dataset.completedAt = String(ts);

    // FLIP: remember where the card is before moving
    const firstRect = card.getBoundingClientRect();

    // Find the first card with a smaller timestamp and insert before it
    const kids = Array.from(completedGrid.children);
    const cardName = (card.querySelector('.name-txt')?.textContent || '').toLowerCase();
    const beforeNode = kids.find(k => {
        const kt = (parseInt(k.dataset.completedAt || '0', 10) || 0);
        if (kt < ts) return true;                    // newer first
        if (kt > ts) return false;
        const kn = (k.querySelector('.name-txt')?.textContent || '').toLowerCase();
        return kn.localeCompare(cardName) > 0;       // tie-break by name
    });

    if (beforeNode) {
        completedGrid.insertBefore(card, beforeNode);
    } else {
        completedGrid.appendChild(card);
    }

    // Animate from old spot to new spot
    const lastRect = card.getBoundingClientRect();
    const dx = firstRect.left - lastRect.left;
    const dy = firstRect.top - lastRect.top;
    card.style.transform = `translate(${dx}px, ${dy}px)`;
    card.offsetHeight; // reflow
    card.style.transform = '';


    // Lock the button
    const btn = card.querySelector('.complete-btn');
    if (btn) { btn.disabled = true; btn.textContent = 'Completed'; }

    refreshCompletedVisibility();

    // NEW: hard de-dupe — if multiple cards exist for the same student in Completed, keep this one
    const dupes = completedGrid.querySelectorAll(`.student-card[data-student-email="${email}"]`);
    if (dupes.length > 1) {
        dupes.forEach(el => { if (el !== card) el.remove(); });
    }

}






