function escapeHtml(s) { return String(s || '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch])); }

// Turn "Minh Do Duy" -> "Minh_DD"; emails -> local-part
function miniName(full) {
    const raw = String(full || '').trim();
    if (!raw) return '';
    if (raw.includes('@')) return raw.split('@')[0]; // email -> local
    const parts = raw.replace(/\s+/g, ' ').trim().split(' ');
    if (parts.length === 1) return parts[0];
    const first = parts[0];
    const initials = parts.slice(1).map(w => w[0]?.toUpperCase() || '').join('');
    return `${first}_${initials}`;
}

// Bangkok day-of-week -> 0..6 (Sun=0)
function getBangkokDow() {
    const s = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Bangkok', weekday: 'short' }).format(new Date());
    const map = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    return map[s] ?? 0;
}


function getBangkokYMD() {
    return new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Asia/Bangkok',
        year: 'numeric', month: '2-digit', day: '2-digit'
    }).format(new Date()); // "YYYY-MM-DD"
}


// === Re-sync helper (used after reconnect / visibility / cross-tab) ===
let _lostRealtime = false;

// === Realtime health markers (watchdog + backoff) ===
let _rtSetupLast = 0;                 // last time we rebuilt channels
let _rtLastSignal = Date.now();
window._rtLastSignal = _rtLastSignal; // keep RT badge in sync from the start

const RT_STALE_MS = 120000;           // 2 minutes of silence = rebuild

// Exponential backoff (1s → 2s → 4s → 8s → 16s → 30s cap) + jitter
let _rtRetryCount = 0;
let _rtBackoffTimer = null;

function markRTSignal() {
    _rtLastSignal = Date.now();
    window._rtLastSignal = _rtLastSignal; // <-- needed by the RT badge
}


function resetRtBackoff() {
    _rtRetryCount = 0;
    if (_rtBackoffTimer) { clearTimeout(_rtBackoffTimer); _rtBackoffTimer = null; }
}

function scheduleRtRetry(why = '') {
    if (window._rtSetupInProgress) return;       // don't fight an in-flight setup
    if (_rtBackoffTimer) clearTimeout(_rtBackoffTimer);

    const delay = Math.min(30000, 1000 * Math.pow(2, Math.max(0, _rtRetryCount)))  // 1s..30s
        + Math.floor(Math.random() * 400);                                 // jitter
    _rtRetryCount = Math.min(_rtRetryCount + 1, 5);

    console.warn(`[realtime] scheduling rebuild in ~${Math.round(delay / 1000)}s${why ? ' — ' + why : ''}`);
    _rtBackoffTimer = setTimeout(() => {
        _rtBackoffTimer = null;
        try { setupRealtime(); } catch { }
        try { resync('rt-backoff', true); } catch { }
    }, delay);
}


const resync = (() => {
    let last = 0;
    return (why = '', silent = true) => {
        const now = Date.now();
        if (now - last < 1500) return; // debounce
        last = now;
        try {
            if (silent) refreshSilent();
            else refreshWithSpinner(why);
        } catch (e) { console.error(e); }
    };
})();


// --- Realtime health snapshot (ADD THIS) ---
window._rtStatus = { LSR: 'INIT', NGAN: 'INIT', MISC: 'INIT' };
function rtHealth(tag = '') {
    const secs = Math.floor((Date.now() - _rtLastSignal) / 1000);
    const allUp = Object.values(window._rtStatus).every(s => s === 'SUBSCRIBED');
    const msg = allUp ? '✅ Realtime healthy' : '⚠️ Realtime not ready';
    console.log(
        `[realtime] ${msg}${tag ? ' — ' + tag : ''} | channels: ${JSON.stringify(window._rtStatus)} | last signal ${secs}s ago`
    );
}
// optional: let you type rtHealth() in the Console
window.rtHealth = rtHealth;


async function setupRealtime() {

    if (window._rtSetupInProgress) {
        console.log('setupRealtime: already running, skip');
        return;
    }
    window._rtSetupInProgress = true;
    try {
        let rtTimer = null;
        const triggerReload = () => {
            markRTSignal(); // <- record activity
            clearTimeout(rtTimer);
            rtTimer = setTimeout(() => resync('rt-activity', true), 2000); // 2s debounce to reduce flicker
        };





        // --- cleanly remove ANY old channels (IMPORTANT: await) ---
        try {
            if (window._ltChannel) await client.removeChannel(window._ltChannel);
            if (window._ltChannel2) await client.removeChannel(window._ltChannel2);
            if (window._ltChannelMisc) await client.removeChannel(window._ltChannelMisc);
        } catch (_) { }
        window._ltChannel = window._ltChannel2 = window._ltChannelMisc = null;

        // --- fresh token BEFORE creating channels ---
        try { await getFreshToken(); } catch (e) { console.warn('getFreshToken failed', e); }

        // === split channels so bindings are rock-solid ===
        const lsrCh = client.channel('realtime:public:learn_status_reports');
        const nganCh = client.channel('realtime:public:learn_status_reports_bc_ngan');
        const miscCh = client.channel('realtime:misc');

        // learn_status_reports (JOIN/COMPLETE)
        lsrCh.on(
            'postgres_changes',
            { event: '*', schema: 'public', table: 'learn_status_reports' },
            async (payload) => {
                markRTSignal();
                console.log('[rt] LSR EVENT:', payload.eventType, payload.new?.id || payload.old?.id);
                try { await handleLsrChange(payload); } catch (e) { console.error('[rt] handleLsrChange failed', e); }
                // Only reload if the card is not on screen yet (brand new to the list)
                const em = payload?.new?.student_email || payload?.old?.student_email || '';
                if (!document.getElementById(`card_${em}`)) triggerReload();
            }
        );


        // learn_status_reports_bc_ngan (note flag)
        nganCh.on(
            'postgres_changes',
            { event: '*', schema: 'public', table: 'learn_status_reports_bc_ngan' },
            async (payload) => {
                markRTSignal();
                console.log('[rt] NGAN EVENT:', payload.eventType, payload.new?.id || payload.old?.id);
                try { await handleNganChange(payload); } catch (e) { console.error('[rt] handleNganChange failed', e); }
                const em = payload?.new?.student_email || payload?.old?.student_email || '';
                if (!document.getElementById(`card_${em}`)) triggerReload();
            }
        );


        // other tables that just trigger a refresh
        miscCh
            .on('postgres_changes', { event: '*', schema: 'public', table: 'student_schedule' }, triggerReload)
            .on('postgres_changes', { event: '*', schema: 'public', table: 'danh_sach_hv' }, triggerReload)
            .on('postgres_changes', { event: '*', schema: 'public', table: 'user_roles' }, triggerReload)
            .on('postgres_changes', { event: '*', schema: 'public', table: 'offdays_makeup_classes' }, triggerReload);

        // subscribe (await) + log statuses
        const onStatus = (label) => (status) => {
            window._rtStatus[label] = status;
            console.log(`[realtime] ${label} channel status:`, status);

            if (status === 'SUBSCRIBED') {
                markRTSignal();
                // If *all* channels are up, clear backoff and do a tidy resync once.
                const allUp = Object.values(window._rtStatus || {}).every(s => s === 'SUBSCRIBED');
                if (allUp) {
                    resetRtBackoff();
                    if (_lostRealtime) {
                        _lostRealtime = false;
                        try { resync('realtime-rejoined', true); } catch { }
                    }
                }
            } else if (status === 'CHANNEL_ERROR' || status === 'CLOSED' || status === 'TIMED_OUT' || status === 'UNSUBSCRIBED') {
                _lostRealtime = true;
                scheduleRtRetry(`status ${label}→${status}`);
            }

            rtHealth(`status ${label}→${status}`);

            try { window.updateRtBadge?.(); } catch { }

        };




        lsrCh.subscribe(onStatus('LSR'));
        nganCh.subscribe(onStatus('NGAN'));
        miscCh.subscribe(onStatus('MISC'));


        // Quick post-subscribe snapshot (runs once after wiring)
        setTimeout(() => {
            const allUp = Object.values(window._rtStatus || {}).every(s => s === 'SUBSCRIBED');
            if (allUp) {
                resetRtBackoff();
