                .from('student_schedule')
                .select('student_email, breakout_email')
                .in('student_email', emails));
        }

        if (error) { console.error('[breakout] query error:', error); return; }
        console.log('[breakout] rows:', data?.length, { dow, emailsCount: emails.length });

        // Consolidate by student (dedupe)
        const map = new Map(); // email -> Set of breakout emails
        for (const r of (data || [])) {
            const b = String(r?.breakout_email || '').trim();
            if (!b) continue;
            if (!map.has(r.student_email)) map.set(r.student_email, new Set());
            map.get(r.student_email).add(b);
        }


