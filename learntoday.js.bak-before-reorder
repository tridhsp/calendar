    // Turn any element with data-breakout-email into a link using meeting_links.link_meeting_goc
    async function linkifyBreakoutEmails() {
        try {
            // Find all labels we just rendered that carry breakout emails
            const els = Array.from(document.querySelectorAll('#activeGrid [data-breakout-email]'));
            const emails = Array.from(new Set(
                els.map(el => (el.getAttribute('data-breakout-email') || '').trim()).filter(Boolean)
            ));
            if (!emails.length) return;

            // Fetch meeting links for those emails
            const { data, error } = await client
                .from('meeting_links')
                .select('teacher_email, link_meeting_goc')
                .in('teacher_email', emails);

            if (error) { console.warn('[meeting_links] lookup error:', error); return; }

            const map = new Map();
            for (const row of (data || [])) {
                const em = String(row?.teacher_email || '').trim();
                let url = String(row?.link_meeting_goc || '').trim();
                // If they saved "meet.google.com/..." (no scheme), add https://
                if (url && !/^https?:\/\//i.test(url)) url = 'https://' + url.replace(/^\/+/, '');

                // only allow http(s)
                if (em && /^https?:\/\//i.test(url)) map.set(em, url);
            }

            // Idempotent upgrade: if it's already an <a>, update href; otherwise make it clickable in place
            for (const el of els) {
                const em = el.getAttribute('data-breakout-email') || '';
                const href = map.get(em);
                if (!href) continue;

                // Already an anchor? just ensure attributes
                if (el.tagName === 'A') {
                    el.setAttribute('href', href);
                    el.setAttribute('target', '_blank');
                    el.setAttribute('rel', 'noopener noreferrer');
                    continue;
                }

                // Upgrade in place, no node replacement (prevents flicker)
                if (el.dataset.linkified === '1') continue;
                el.dataset.linkified = '1';
                el.setAttribute('role', 'link');
                el.setAttribute('tabindex', '0');
                el.title = el.title || 'Open meeting';
                el.style.cursor = 'pointer';
                el.addEventListener('click', () => window.open(href, '_blank', 'noopener,noreferrer'));
                el.addEventListener('keydown', (ev) => {
                    if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); window.open(href, '_blank', 'noopener,noreferrer'); }
                }, { passive: false });
            }

        } catch (e) {
            console.error('linkifyBreakoutEmails failed', e);
        }
