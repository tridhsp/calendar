// Bind + Student and wire suggestions (debounce 1s from user_roles.full_name)
document.addEventListener('DOMContentLoaded', () => {

    const btn = document.getElementById('openAddStudent');
    const overlay = document.getElementById('addStudentBox');
    const input = document.getElementById('addStudentInput');
    const list = document.getElementById('addStudentSuggest');

    const MIN_LEN = 4;
    const DEBOUNCE_MS = 1000;
    let suggestTimer = null;

    let suggestSeq = 0;
    let lastDeliveredSeq = 0;
    let suggestAbort = null;


    function renderSuggestions(rows) {
        if (!list) return;
        if (!rows || rows.length === 0) {
            list.innerHTML = '<div class="suggest-item disabled">No matches</div>';
            list.hidden = false;
            return;
        }
        list.innerHTML = rows.map(r => `
      <div class="suggest-item"
           data-name="${escapeHtml(r.full_name || '')}"
           data-email="${escapeHtml(r.email || '')}">
        <span class="si-name">${escapeHtml(r.full_name || '')}</span>
        <span class="si-email">${escapeHtml(r.email || '')}</span>
      </div>
    `).join('');
        list.hidden = false;
    }

    async function fetchSuggestions(q) {
        // Guard: wait until Supabase client is ready
        if (typeof client === 'undefined' || !client) return;

        // cancel any in-flight request
        if (suggestAbort) { try { suggestAbort.abort(); } catch { } }
        suggestAbort = new AbortController();
        const mySeq = ++suggestSeq;

        try {
            // Build exclude list = emails already visible on page
            const onPageEmails = Array.from(
                (window._ltState && window._ltState.byStudent)
                    ? window._ltState.byStudent.keys()
                    : []
            ).map(e => String(e || '').toLowerCase());

            // Get access token to authorize the server function (same as other funcs)
            const r = await fetchWithAuth('/api/user-role-suggest', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ q, exclude_emails: onPageEmails }),
                signal: suggestAbort.signal
            });

            if (!r.ok) {
                const msg = await r.text().catch(() => '');
                throw new Error(msg || 'Suggest request failed');
            }

            const out = await r.json();
            const rows = Array.isArray(out?.data) ? out.data : [];

            // only allow newest response to render
            if (mySeq <= lastDeliveredSeq) return;
            lastDeliveredSeq = mySeq;

            if (!rows.length) {
                if (!list) return;
                list.innerHTML = '<div class="suggest-item disabled">No matches</div>';
                list.hidden = false;
                return;
            }

            renderSuggestions(rows);
        } catch (err) {
            if (err?.name === 'AbortError') return; // ignore canceled requests
            console.error('Suggest error:', err);
            if (list) {
                list.innerHTML = '<div class="suggest-item disabled">Error searching</div>';
                list.hidden = false;
            }
        }
    }



    // Open the popup (unchanged behavior)
    if (btn && !window._addStudentBound) {
        btn.addEventListener('click', async () => {
            const { ok, value } = await showAddStudentDialog(input?.value || '');
            if (!ok) return;

            const email = (input?.dataset?.email || '').trim();
            const name = (value || '').trim();

            if (!email) {
                alert('Vui lòng chọn một học viên từ danh sách gợi ý.');
                return;
            }

            try {
                await addStudentAndJoin({ email, name });
            } catch (err) {
                console.error(err);
                alert('Không thể thêm học viên. Vui lòng thử lại.');
            }
        });


        window._addStudentBound = true;
    }

    // Debounced lookup: type ≥ 4 characters → wait 1s → search user_roles.full_name
    if (input && list && !window._addStudentSuggestBound) {
        input.addEventListener('input', () => {
            if (!list) return;
            list.hidden = true;
            list.innerHTML = '';

            const q = (input.value || '').trim();
            if (q.length < MIN_LEN) return;

            clearTimeout(suggestTimer);
            suggestTimer = setTimeout(() => fetchSuggestions(q), DEBOUNCE_MS);
        });

        // Click a suggestion → fill input and remember the email in dataset
        list.addEventListener('click', (e) => {
            const item = e.target.closest('.suggest-item');
            if (!item || item.classList.contains('disabled')) return;
            input.value = item.dataset.name || '';
            input.dataset.email = item.dataset.email || '';
            list.hidden = true;
            input.focus();
            input.select();
        });

        // Clicking the dim area of the popup hides suggestions
        overlay?.addEventListener('click', (e) => {
            if (e.target === overlay && list) list.hidden = true;
        });

        window._addStudentSuggestBound = true;
    }
});




// Patch UI from learn_status_reports row changes (today only)
async function handleLsrChange(payload) {

    // >>> NEW: handle DELETE to revert UI immediately
    if (payload.eventType === 'DELETE') {
        const email = payload.old?.student_email;
        if (email) {
            // stop timers
            stopStopwatchFor(email);
            pauseTimeLeftFor(email);
            PENDING_LSR.delete(email);
            try { window._ltState?.joinedTodaySet?.delete(email); } catch (_) { }

            // reset UI on the card
            const card = document.getElementById(`card_${email}`);
            if (card) {
                card.classList.remove('exceeded-alert');

                const joinEl = card.querySelector('.join-input');
                if (joinEl) { joinEl.checked = false; joinEl.disabled = false; }

                const sdWrap = document.getElementById(`sd_wrap_${email}`);
                if (sdWrap) sdWrap.hidden = true;

                const tuWrap = document.getElementById(`tu_wrap_${email}`);
                if (tuWrap) tuWrap.hidden = true;

                const tlWrap = document.getElementById(`tl_wrap_${email}`);
                if (tlWrap) {
                    tlWrap.hidden = true;
                    tlWrap.classList.remove('alert', 'exceeded');
                    const lbl = tlWrap.querySelector('.tl-label');
                    if (lbl) lbl.textContent = 'Time left';
                }

                const cb = document.getElementById(`comp_${email}`);
                if (cb) { cb.hidden = true; cb.disabled = false; cb.textContent = 'Complete'; }

                // if the card was in Completed, move it back to Active
                const completedGrid = document.getElementById('completedGrid');
                if (completedGrid && completedGrid.contains(card)) {
                    const activeGrid = document.getElementById('activeGrid');
                    if (activeGrid) activeGrid.appendChild(card);
                    refreshCompletedVisibility();
                }
            }

            if (window.requestGridReorder) window.requestGridReorder();

        }
        return; // important: don't continue to fetch-by-id (row is gone)
    }


    // Always fetch the freshest row by ID (payloads can be partial)
    let row = payload.new || payload.old || {};
    const rowId = row.id ?? payload.new?.id ?? payload.old?.id;
    let email = row.student_email || null;

    if (rowId) {
        try {
            const { data: fresh } = await client
                .from('learn_status_reports')
                .select('id, student_email, start_time, email_gv_complete, completed_at, early_start, late_start, time_used, time_left, time_exceeded')
                .eq('id', rowId)
                .maybeSingle();
            if (fresh) { row = fresh; email = fresh.student_email; }
        } catch (e) {
            console.warn('[rt] fetch-by-id failed', e);
        }
    }

    // If we still don't know who this is, we can't patch the DOM
    if (!email) {
        return;
    }


    // Keep it locally so the next repaint can't "forget" this change
    rememberPendingLsr(row);


    // Ignore non-today rows to prevent flicker
    const isStartToday = row.start_time && isBangkokSameDay(row.start_time);
    const isCompletedToday = row.completed_at && isBangkokSameDay(row.completed_at);
    if (!isStartToday && !isCompletedToday) {
        return; // don't touch the DOM for old data
    }

    if (!email) return;

    const card = document.getElementById(`card_${email}`);
    if (!card) {
        // Card not found. Skipping refresh (disabled).
        return;
    }



    const hvByEmail = (window._ltState && window._ltState.hvByEmail) || new Map();
    const byStudent = (window._ltState && window._ltState.byStudent) || new Map();

    // If a start_time exists (joined) and NOT yet completed -> start timers + badges
    if (row.start_time && !row.email_gv_complete) {
        window._ltState?.joinedTodaySet?.add(email);   // NEW: treat as joined for sorting

        // Early/Late badge
        if (row.early_start) {
            showStartDelta(email, 'Early', row.early_start);

        } else if (row.late_start) {
            showStartDelta(email, 'Late', row.late_start);
        } else {
            try {
                const schedTimes = (byStudent.get(email) || []).map(s => s.time_local);
                const data = await serverComputeStartDelta(row.start_time, schedTimes);
                if (data?.label && data?.hhmmss != null) {
                    showStartDelta(email, data.label, data.hhmmss);
                } else {
                    showStartDelta(email, 'On time', '00:00:00');
                }
            } catch (_) {
                // Fallback if server call fails
                const schedHHMM = getEarliestTimeLocalFor(email, byStudent);
                const deltaMs = diffFromScheduledMs(row.start_time, schedHHMM);
                const hhmmss = formatHMS(Math.abs(deltaMs));
                if (Math.abs(deltaMs) <= 999) showStartDelta(email, 'On time', '00:00:00');
                else if (deltaMs < 0) showStartDelta(email, 'Early', hhmmss);
                else showStartDelta(email, 'Late', hhmmss);
            }
        }


        // Toggle joined UI
        const joinEl = card.querySelector('.join-input');
        if (joinEl) { joinEl.checked = true; joinEl.disabled = true; }

        // Time used
        const tuWrap = document.getElementById(`tu_wrap_${email}`);
        const tuEl = document.getElementById(`tu_${email}`);
        if (tuWrap) tuWrap.hidden = false;
        if (tuEl) startStopwatchFor(tuEl, row.start_time, email);

        // Time left
        const limitMins = computeLimitMins(
            email,
            byStudent,
            hvByEmail,
            window._ltState?.perStudent || {}
        );

        const tlWrap = document.getElementById(`tl_wrap_${email}`);
        const tlEl = document.getElementById(`tl_${email}`);
        if (tlWrap && tlEl && limitMins > 0) {
            tlWrap.hidden = false;
            startTimeLeftFor(tlEl, row.start_time, limitMins, email);
        }

        // Enable Complete button
        const cb = document.getElementById(`comp_${email}`);
        if (cb) { cb.hidden = false; cb.disabled = !!row.email_gv_complete; }

        if (window.requestGridReorder) window.requestGridReorder();

    }

    // If completed -> stop timers, show saved values, move card
    if (row.email_gv_complete || row.completed_at) {
        stopStopwatchFor(email);
        pauseTimeLeftFor(email);

        const tuWrap = document.getElementById(`tu_wrap_${email}`);
        const tuEl = document.getElementById(`tu_${email}`);
        if (tuWrap) tuWrap.hidden = false;
        if (tuEl && row.time_used) tuEl.textContent = row.time_used;

        const tlWrap = document.getElementById(`tl_wrap_${email}`);
        const tlEl = document.getElementById(`tl_${email}`);
        if (tlWrap && tlEl) {
            tlWrap.hidden = false;
            tlWrap.classList.remove('alert', 'exceeded');
            const lbl = tlWrap.querySelector('.tl-label');
            if (row.time_exceeded) {
                tlEl.textContent = row.time_exceeded;
                if (lbl) lbl.textContent = 'Exceeded';
                tlWrap.classList.add('alert', 'exceeded');
                const cardEl = tlWrap.closest('.student-card');
                if (cardEl) cardEl.classList.add('exceeded-alert');
            } else if (row.time_left) {
                tlEl.textContent = row.time_left;
                if (lbl) lbl.textContent = 'Time left';
                if (card) card.classList.remove('exceeded-alert');
            }

        }

        // NEW: keep Early/Late/On time badge after completion
        const sdWrap = document.getElementById(`sd_wrap_${email}`);
        if (sdWrap) sdWrap.hidden = false;

        if (row.early_start) {
            showStartDelta(email, 'Early', row.early_start);
        } else if (row.late_start) {
            showStartDelta(email, 'Late', row.late_start);
        } else if (row.start_time) {
            try {
                const schedTimes = (byStudent.get(email) || []).map(s => s.time_local);
                const data = await serverComputeStartDelta(row.start_time, schedTimes);
                if (data?.label && data?.hhmmss != null) {
                    showStartDelta(email, data.label, data.hhmmss);
                }
            } catch (_) { /* ignore */ }
        }

        const cb = document.getElementById(`comp_${email}`);
        if (cb) { cb.hidden = false; cb.disabled = true; cb.textContent = 'Completed'; }

        moveCardToCompleted(email, row.completed_at || new Date().toISOString());
        if (window.requestGridReorder) window.requestGridReorder();

    }

}

