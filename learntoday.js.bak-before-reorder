// Measure current positions of cards (by student email)
function measureRectsByKey(container) {
    const map = new Map();
    container.querySelectorAll('.student-card').forEach(el => {
        const k = el.dataset.studentEmail;
        if (k) map.set(k, el.getBoundingClientRect());
    });
    return map;
}

// Animate from "before" positions to the new layout (FLIP)
function animateFlip(container, beforeRects) {
    container.querySelectorAll('.student-card').forEach(el => {
        const k = el.dataset.studentEmail; if (!k) return;
        const before = beforeRects.get(k); if (!before) return;
        const after = el.getBoundingClientRect();
        const dx = before.left - after.left;
        const dy = before.top - after.top;
        if (!dx && !dy) return;
        el.style.transform = `translate(${dx}px, ${dy}px)`;
        // kick off transition
        el.offsetHeight; // reflow
        el.style.transform = '';
        el.addEventListener('transitionend', () => { el.style.transform = ''; }, { once: true });
    });
}



function setTextIfDiff(node, text) {
    if (node && node.textContent !== text) node.textContent = text;
}

function weekdayShort(i) { return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][i]; }


// Is an ISO timestamp on the same Bangkok day as now?
function isBangkokSameDay(iso) {
    if (!iso) return false;
    const ms = toSafeMs(iso);
    const fmt = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Asia/Bangkok', year: 'numeric', month: '2-digit', day: '2-digit'
    });
    const ymd = fmt.format(new Date(ms));           // date of the timestamp in Bangkok
    return ymd === getBangkokYMD();                 // compare to "today" (Bangkok)
}

function dayCss(i) { return ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'][i] || 'sun'; }
function formatTime(t) {
    const norm = normalizeHHMM(t); // coercion handles "8:00 pm", "08:00", etc.
    if (!norm) return '';
    const [h, m] = norm.split(':').map(Number);
    const ampm = h >= 12 ? 'PM' : 'AM';
    const h12 = (h % 12) || 12;
    return `${String(h12).padStart(2, '0')}:${String(m).padStart(2, '0')} ${ampm}`;
}



function timeToMinutes(t) {
    const norm = normalizeHHMM(t);
    if (!norm) return Infinity; // treat invalid as "very late" for sorting
    const [h, m] = norm.split(':').map(Number);
    return h * 60 + m;
}

function computeLimitMins(email, byStudent, hvByEmail, perStudent) {
    // 1) If boot precomputed it, prefer that
    const boot = perStudent?.[email]?.limitMins;
    if (Number.isFinite(boot) && boot > 0) return boot;

    // 2) Buổi phụ rule
    const hasExtra = (byStudent.get(email) || []).some(s => s.buoi_phu === true);
    if (hasExtra) return 25;

    // 3) Fallback to profile max
    const max = Number(hvByEmail.get(email)?.max) || 0;
    return max > 0 ? max : 0;
}



// Current time (minutes) in Bangkok
function getBangkokNowMinutes() {
    const fmt = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: 'Asia/Bangkok'
    });
    const hhmm = fmt.format(new Date()); // "HH:MM"
    const [hh = 0, mm = 0] = hhmm.split(':').map(Number);
    return hh * 60 + mm;
}


