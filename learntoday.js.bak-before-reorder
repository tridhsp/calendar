            alert('Cannot open confirm dialog. Please reload the page.');
            return resolve({ ok: false, imageUrl: '' });
        }

        let isUploading = false;

        // Default texts for JOIN popup
        emojiEl.textContent = '📝';
        titleEl.innerHTML = `Bạn muốn <b>BC giờ bắt đầu</b> cho HV <span class="hv-name">${escapeHtml(studentName || '')}</span>?`;
