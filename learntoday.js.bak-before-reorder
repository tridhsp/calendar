    const AUTO_REFRESH_MS = 120000; // 2 minutes
    setInterval(async () => {
        if (document.hidden && navigator.onLine) {
            try { await refreshSilent(); } catch (_) { }
        }
    }, AUTO_REFRESH_MS);

    // 4) When auth changes (token refresh, etc), give Realtime the fresh token
    client.auth.onAuthStateChange((_event, s) => {
        try { client.realtime.setAuth(s?.access_token || null); } catch { }
    });

    // 5) Re-subscribe the realtime channel when socket closes / tab comes back
    if (!window._ltRealtimeWired) {
        window._ltRealtimeWired = true;
        try {
            client.realtime.onClose?.(() => {
                if (ENABLE_RT_HARDEN) scheduleRtRetry('rt-closed');
                resync('rt-closed', true);
            });
            client.realtime.onError?.(() => {
                if (ENABLE_RT_HARDEN) scheduleRtRetry('rt-error');
                resync('rt-error', true);
            });
        } catch { }
    }
}


