        // Paste-only: no typing allowed
        inputEl.readOnly = true;
        inputEl.value = presetUrl || '';
        inputEl.placeholder = 'Dán (Ctrl+V) ảnh bạn đã chụp màn hình vào đây';

        // Build (or reuse) the small status indicator under the input
        let status = document.getElementById('joinImageStatus');
        if (!status) {
            status = document.createElement('div');
            status.id = 'joinImageStatus';
            status.style.cssText = 'margin-top:6px; font-size:12px; text-align:right; font-weight:600;';
            // insert it right after the input's wrapper (same container as the input)
            const wrap = inputEl.closest('.input-with-copy') || inputEl.parentNode;
            wrap.parentNode.insertBefore(status, wrap.nextSibling);
        }
        status.hidden = false;

        const updateStatus = () => {
            const hasImg = !!(inputEl.value || '').trim();
            if (hasImg) {
                status.textContent = '✓ Đã có ảnh';
                status.style.color = '#16a34a';
                okBtn.disabled = false;
                okBtn.style.opacity = '';
                okBtn.style.cursor = '';
            } else {
                status.textContent = 'Chưa có ảnh — hãy dán ảnh (Ctrl+V) vào ô trên';
                status.style.color = '#dc2626';
                okBtn.disabled = true;
                okBtn.style.opacity = '0.5';
                okBtn.style.cursor = 'not-allowed';
            }
        };
        updateStatus();

        overlay.hidden = false;
        setTimeout(() => inputEl.focus(), 50);

        const close = (ans) => {
            // Block OK if no image yet
            if (ans && !(inputEl.value || '').trim()) {
                return;
            }

            const finalValue = (inputEl.value || '').trim();

            overlay.hidden = true;
            if (spinEl) spinEl.hidden = true;

            // Reset input back to normal for other popups
            inputEl.readOnly = false;
            inputEl.disabled = false;

            // Hide the status indicator
            if (status) status.hidden = true;

            // Restore OK button styling
            okBtn.disabled = false;
            okBtn.style.opacity = '';
            okBtn.style.cursor = '';

            okBtn.removeEventListener('click', onOk);
            cancelBtn.removeEventListener('click', onCancel);
            overlay.removeEventListener('click', onBackdrop);
            if (copyBtn) copyBtn.removeEventListener('click', onCopy);
            inputEl.removeEventListener('paste', onPaste);

            // Restore copy button visibility for next popup use
            if (copyBtn) copyBtn.hidden = false;

            resolve({ ok: ans, imageUrl: finalValue });
        };
        const onOk = () => close(true);
        const onCancel = () => close(false);
        const onBackdrop = (e) => { if (e.target === overlay) close(false); };

        okBtn.addEventListener('click', onOk);
        cancelBtn.addEventListener('click', onCancel);
        overlay.addEventListener('click', onBackdrop);

        const onCopy = () => {
            if (!inputEl.value) return;
            navigator.clipboard.writeText(inputEl.value).catch(() => { });
        };
        if (copyBtn) copyBtn.addEventListener('click', onCopy);

        // Paste → upload (with status update)
        const onPaste = async (e) => {
            const item = Array.from(e.clipboardData?.items || [])
                .find(it => it.type && it.type.startsWith('image/'));
            if (!item) return;
            e.preventDefault();
            if (isUploading) return;
            isUploading = true;

            const oldPh = inputEl.placeholder;
            if (spinEl) spinEl.hidden = false;
            inputEl.disabled = true;
            okBtn.disabled = true;
            okBtn.style.opacity = '0.5';
            okBtn.style.cursor = 'not-allowed';
            if (copyBtn) copyBtn.disabled = true;
            inputEl.placeholder = 'Đang tải ảnh…';
            status.textContent = 'Đang tải ảnh lên máy chủ…';
            status.style.color = '#2563eb';

            try {
                const blob = item.getAsFile();
                const ext = (blob.type.split('/')[1] || 'png').toLowerCase();
                const publicUrl = await uploadToWasabi(blob, ext);
                inputEl.value = publicUrl;

            } catch (err) {
                console.error('Upload failed:', err);
                alert('Không thể tải ảnh. Vui lòng thử lại.');
            } finally {
                isUploading = false;
                if (spinEl) spinEl.hidden = true;
                inputEl.disabled = false;
                if (copyBtn) copyBtn.disabled = false;
                inputEl.placeholder = oldPh;
                updateStatus();
            }
        };

        inputEl.addEventListener('paste', onPaste);
    });
}



// === Test_Prep: after Complete, prompt for a reason if the learner was not scored today. ===
async function maybePromptTestPrepNoScore(studentEmail, studentName, completedBy) {
