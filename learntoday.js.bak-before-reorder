            }
        }
        if (unknown.length) {
            const { data: people } = await client
                .from('user_roles')
                .select('email, full_name')
                .in('email', unknown);
            for (const p of (people || [])) {
                if (p?.email) teacherNameByEmail.set(p.email, p.full_name || p.email);
            }
        }


        for (const [email, set] of map) {
            const card = document.getElementById(`card_${email}`);
