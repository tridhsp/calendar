<script>
(function(){
  var overlay = document.getElementById('luyenThiOverlay');
  if (!overlay) return;
  var _resolve = null;
  // Returns a Promise that resolves when the teacher closes the popup,
  // so the Join flow can wait for it. (email kept for the future "luyen thi only" rule.)
  window.showLuyenThiMockTest = function(email){
    window._luyenThiEmail = email || null;
    overlay.style.display = 'flex';
    return new Promise(function(res){ _resolve = res; });
  };
  function closePopup(){
    overlay.style.display = 'none';
    if (_resolve){ var r = _resolve; _resolve = null; r(); }
  }
  window.hideLuyenThiMockTest = closePopup;
  var okBtn = document.getElementById('luyenThiOkBtn');
  if (okBtn) okBtn.addEventListener('click', closePopup);
  var scoreBtn = document.getElementById('luyenThiScoreBtn');
  if (scoreBtn) scoreBtn.addEventListener('click', function(){ window.open('https://score.tansinh.info', '_blank', 'noopener'); });
  overlay.addEventListener('click', function(e){ if (e.target === overlay) closePopup(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && overlay.style.display === 'flex') closePopup(); });
})();
</script>
